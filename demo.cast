[3.7, "o", "Функция insert выполнилась за 0.000 секунд.\n"]
[4.2, "o", "\nВведите команду: "]
[4.6, "o", "select from users\n"]
[4.9, "o", "Функция select выполнилась за 0.000 секунд.\n"]
[5.1, "o", "+----+--------+-----+-----------+\n"]
[5.2, "o", "| ID |  name  | age | is_active |\n"]
[5.3, "o", "+----+--------+-----+-----------+\n"]
