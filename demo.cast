[5.5, "o", "+----+--------+-----+-----------+\n"]
[6.0, "o", "\nВведите команду: "]
[6.5, "o", "update users set age = 29 where name = \"Sergei\"\n"]
[6.8, "o", "Обновлено записей: 1.\n"]
[7.3, "o", "\nВведите команду: "]
[7.8, "o", "select from users where name = \"Sergei\"\n"]
[8.1, "o", "Функция select выполнилась за 0.000 секунд.\n"]
[8.3, "o", "+----+--------+-----+-----------+\n"]
[8.4, "o", "| ID |  name  | age | is_active |\n"]
[8.5, "o", "+----+--------+-----+-----------+\n"]
[8.6, "o", "| 1  | Sergei | 29  |    True   |\n"]
[8.7, "o", "+----+--------+-----+-----------+\n"]
[9.2, "o", "\nВведите команду: "]
